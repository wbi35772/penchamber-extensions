{
  "name": "shardx",
  "version": "1.3.0",
  "description": "ShardX fingerprint-browser workspace tools exposed over MCP (stdio): folder/profile management, isolated sessions, shared mappings, reusable skills, and launcher control.",
  "transport": "stdio",
  "tools": [
    {
      "name": "list_and_bind_profile",
      "description": "列出本机 ShardX 指纹环境（带文件夹分组统计），或把某个空闲 profile 绑定到当前会话并启动实例；action=folders 只返回分组摘要。同一 profile 只能被一个会话独占，一个会话可以有多个实例。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "default": "default",
            "description": "会话标识，用于隔离实例；同一次对话保持一致"
          },
          "action": {
            "type": "string",
            "enum": [
              "list",
              "folders",
              "bind",
              "auto-bind"
            ],
            "description": "list=列出环境；folders=只看分组；bind=绑定 profile_id；auto-bind=自动挑一个未占用且未运行的"
          },
          "profile_id": {
            "type": "string",
            "description": "要绑定的 profile ID（action=bind 时必填）"
          },
          "folder": {
            "type": "string",
            "description": "按文件夹筛选（list / auto-bind 时可选）"
          },
          "query": {
            "type": "string",
            "description": "按名称 / ID / 文件夹模糊筛选（action=list）"
          },
          "limit": {
            "type": "number",
            "description": "action=list 最多显示多少个环境"
          },
          "include_profiles": {
            "type": "boolean",
            "description": "action=folders 时是否带上每个分组的 profile 列表"
          },
          "headless": {
            "type": "boolean",
            "description": "无头启动（action=bind / auto-bind）"
          },
          "password": {
            "type": "string",
            "description": "受密码保护的 profile 需要密码"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "session_attach",
      "description": "接管一个已经在 ShardX 中运行的实例（不重复启动），把它绑定到当前会话并写入共享映射。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "default": "default",
            "description": "会话标识，用于隔离实例；同一次对话保持一致"
          },
          "profile_id": {
            "type": "string",
            "description": "要接管的 profile ID"
          },
          "name": {
            "type": "string",
            "description": "可选显示名，默认取 ShardX 里的环境名"
          },
          "headless": {
            "type": "boolean",
            "description": "实例没在运行时是否无头启动"
          },
          "password": {
            "type": "string",
            "description": "受密码保护的 profile 需要密码"
          }
        },
        "required": [
          "profile_id"
        ]
      }
    },
    {
      "name": "session_navigate",
      "description": "在当前会话绑定的指纹浏览器里打开或跳转 URL，并等待页面加载。会话有多个实例时用 profile_id 指定。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "default": "default",
            "description": "会话标识，用于隔离实例；同一次对话保持一致"
          },
          "profile_id": {
            "type": "string",
            "description": "会话内多实例时指定要操作的实例；省略时用该会话唯一的实例"
          },
          "url": {
            "type": "string",
            "description": "目标 URL"
          },
          "wait_until": {
            "type": "string",
            "enum": [
              "load",
              "domcontentloaded",
              "networkidle"
            ],
            "default": "networkidle"
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "session_interact",
      "description": "在当前会话实例中执行交互：click / type / scroll / hover / press / select / check / uncheck / back / forward / reload / get_text / get_html / get_value / exists / count / links / wait / snapshot / tabs / evaluate_js。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "default": "default",
            "description": "会话标识，用于隔离实例；同一次对话保持一致"
          },
          "profile_id": {
            "type": "string",
            "description": "会话内多实例时指定要操作的实例；省略时用该会话唯一的实例"
          },
          "action": {
            "type": "string",
            "enum": [
              "click",
              "type",
              "scroll",
              "hover",
              "press",
              "select",
              "check",
              "uncheck",
              "back",
              "forward",
              "reload",
              "get_text",
              "get_html",
              "get_value",
              "exists",
              "count",
              "links",
              "wait",
              "snapshot",
              "tabs",
              "evaluate_js"
            ]
          },
          "selector": {
            "type": "string",
            "description": "CSS 选择器"
          },
          "text": {
            "type": "string",
            "description": "输入文本（action=type）"
          },
          "key": {
            "type": "string",
            "description": "按键，例如 Enter、Escape、Control+A（action=press）"
          },
          "value": {
            "type": "string",
            "description": "select 的选项值"
          },
          "url": {
            "type": "string",
            "description": "wait 需要匹配的 URL 片段 / tabs 新标签地址"
          },
          "expression": {
            "type": "string",
            "description": "wait 需要为真的 JS 表达式"
          },
          "timeout_ms": {
            "type": "number",
            "description": "wait 超时毫秒，默认 30000"
          },
          "tab_action": {
            "type": "string",
            "enum": [
              "list",
              "open",
              "switch",
              "close"
            ],
            "description": "action=tabs 时的标签操作"
          },
          "index": {
            "type": "number",
            "description": "标签序号（tabs switch/close）"
          },
          "target_id": {
            "type": "string",
            "description": "标签 targetId（tabs switch/close）"
          },
          "x": {
            "type": "number",
            "description": "点击 X 坐标（可选，配合 y）"
          },
          "y": {
            "type": "number",
            "description": "点击 Y 坐标 / 滚动像素（可选）"
          },
          "script": {
            "type": "string",
            "description": "JS 代码（action=evaluate_js）"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "session_extract_dom",
      "description": "提取当前实例页面的文本、Markdown、HTML 或表单结构。会话有多个实例时用 profile_id 指定。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "default": "default",
            "description": "会话标识，用于隔离实例；同一次对话保持一致"
          },
          "profile_id": {
            "type": "string",
            "description": "会话内多实例时指定要操作的实例；省略时用该会话唯一的实例"
          },
          "selector": {
            "type": "string",
            "description": "CSS 选择器，省略则整页"
          },
          "mode": {
            "type": "string",
            "enum": [
              "markdown",
              "html",
              "forms",
              "text"
            ],
            "default": "markdown"
          }
        }
      }
    },
    {
      "name": "session_manage_cookies",
      "description": "读取、注入或清空当前实例的 Cookie。会话有多个实例时用 profile_id 指定。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "default": "default",
            "description": "会话标识，用于隔离实例；同一次对话保持一致"
          },
          "profile_id": {
            "type": "string",
            "description": "会话内多实例时指定要操作的实例；省略时用该会话唯一的实例"
          },
          "action": {
            "type": "string",
            "enum": [
              "get",
              "set",
              "clear"
            ]
          },
          "cookies_json": {
            "type": "string",
            "description": "Cookie 数组 JSON（action=set），字段同 CDP Network.setCookies"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "session_stop_and_release",
      "description": "关闭当前会话绑定的指纹浏览器实例并释放独占锁。不传 profile_id 时释放该会话的全部实例。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "default": "default",
            "description": "会话标识，用于隔离实例；同一次对话保持一致"
          },
          "profile_id": {
            "type": "string",
            "description": "只释放这个实例（可选）"
          }
        }
      }
    },
    {
      "name": "workspace_state",
      "description": "读取或修改面板与 MCP 共享的映射状态（%APPDATA%\\shardx-workspace\\state.json）：get 读取全部；mapping 写入映射；unmap 删除映射；settings 保存启动器路径。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "get",
              "mapping",
              "unmap",
              "settings"
            ]
          },
          "profile_id": {
            "type": "string"
          },
          "profile_name": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "launcher_path": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "skill_list",
      "description": "列出共享的 Skill 与分配关系，可按关键词过滤；传 profile_id 或 folder 时返回对该目标生效的 Skill。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "profile_id": {
            "type": "string"
          },
          "folder": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "skill_save",
      "description": "创建或更新一个 Skill。步骤 JSON 支持 navigate / reload / wait / click / type / evaluate / extract。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "已有 Skill ID；省略则新建"
          },
          "name": {
            "type": "string"
          },
          "site": {
            "type": "string"
          },
          "url_pattern": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "步骤数组，例如 [{\"action\":\"navigate\",\"url\":\"https://example.com\"},{\"action\":\"wait\",\"ms\":800}]"
          },
          "skill_json": {
            "type": "string",
            "description": "整个 Skill 的 JSON 字符串（与上面的字段二选一）"
          }
        }
      }
    },
    {
      "name": "skill_assign",
      "description": "把 Skill 分配给一个实例（profile）或整个文件夹；remove=true 时移除分配。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "skill_id": {
            "type": "string"
          },
          "target_type": {
            "type": "string",
            "enum": [
              "profile",
              "folder"
            ]
          },
          "target_id": {
            "type": "string"
          },
          "remove": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "skill_id",
          "target_type",
          "target_id"
        ]
      }
    },
    {
      "name": "skill_run",
      "description": "在指定实例（或当前会话唯一实例）上逐步执行一个 Skill，返回每一步的结果；首个失败步骤会中断执行。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "default": "default",
            "description": "会话标识，用于隔离实例；同一次对话保持一致"
          },
          "profile_id": {
            "type": "string",
            "description": "会话内多实例时指定要操作的实例；省略时用该会话唯一的实例"
          },
          "skill_id": {
            "type": "string"
          }
        },
        "required": [
          "skill_id"
        ]
      }
    },
    {
      "name": "server_status",
      "description": "读取 ShardX 启动器状态：安装发现、运行中、版本、API 端口与开关、数据目录、进程列表与共享状态文件路径。",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "server_control",
      "description": "启动、停止或重启 ShardX 启动器，并等待 /health 就绪；可传 launcher_path 覆盖共享设置里的路径。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "start",
              "stop",
              "restart"
            ]
          },
          "launcher_path": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "server_sync",
      "description": "从 ShardX API 同步分组、环境、代理与运行中实例。folderSummary 先返回，避免长 profile 列表把分组信息截断；include_profiles=false 可只拿摘要。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "include_profiles": {
            "type": "boolean",
            "default": true,
            "description": "false 时不返回完整 profiles 数组"
          }
        }
      }
    },
    {
      "name": "session_status",
      "description": "列出当前会话拥有的全部实例：profile、名称、CDP 页面 session、当前 URL 与标题。多实例场景先看这个再操作。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "default": "default",
            "description": "会话标识，用于隔离实例；同一次对话保持一致"
          }
        }
      }
    },
    {
      "name": "session_tabs",
      "description": "管理实例的浏览器标签：list 列出全部页面 target，open 新建，switch 切换，close 关闭；切换后后续工具都作用在新标签上。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "default": "default",
            "description": "会话标识，用于隔离实例；同一次对话保持一致"
          },
          "profile_id": {
            "type": "string",
            "description": "会话内多实例时指定要操作的实例；省略时用该会话唯一的实例"
          },
          "action": {
            "type": "string",
            "enum": [
              "list",
              "open",
              "switch",
              "close"
            ]
          },
          "url": {
            "type": "string",
            "description": "open 时要打开的地址，默认 about:blank"
          },
          "index": {
            "type": "number",
            "description": "标签序号（switch / close）"
          },
          "target_id": {
            "type": "string",
            "description": "标签 targetId（switch / close）"
          }
        },
        "required": [
          "action"
        ]
      }
    },
    {
      "name": "session_wait",
      "description": "等待页面条件满足：selector 出现、text 出现、url 包含、或 JS expression 为真；超时抛错。比盲目 sleep 稳定。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "default": "default",
            "description": "会话标识，用于隔离实例；同一次对话保持一致"
          },
          "profile_id": {
            "type": "string",
            "description": "会话内多实例时指定要操作的实例；省略时用该会话唯一的实例"
          },
          "selector": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "expression": {
            "type": "string"
          },
          "timeout_ms": {
            "type": "number",
            "default": 30000
          }
        }
      }
    },
    {
      "name": "session_snapshot",
      "description": "一次性返回页面快照：URL、标题、可见文本、链接、表单字段与按钮。用于让 Agent 低成本理解页面并决定下一步。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "default": "default",
            "description": "会话标识，用于隔离实例；同一次对话保持一致"
          },
          "profile_id": {
            "type": "string",
            "description": "会话内多实例时指定要操作的实例；省略时用该会话唯一的实例"
          },
          "max_text": {
            "type": "number",
            "description": "正文最多字符，默认 6000"
          },
          "max_links": {
            "type": "number",
            "description": "链接最多条数，默认 80"
          },
          "max_fields": {
            "type": "number",
            "description": "表单字段最多条数，默认 60"
          }
        }
      }
    },
    {
      "name": "session_screenshot",
      "description": "截取当前实例可见区域（或整页）PNG，直接作为图片返回。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "default": "default",
            "description": "会话标识，用于隔离实例；同一次对话保持一致"
          },
          "profile_id": {
            "type": "string",
            "description": "会话内多实例时指定要操作的实例；省略时用该会话唯一的实例"
          },
          "full_page": {
            "type": "boolean",
            "description": "true 时截整页"
          }
        }
      }
    },
    {
      "name": "folder_list",
      "description": "读取 ShardX 的分组：每个文件夹的环境数、运行中数量、已分配 Skill；可选带上分组内 profile 列表。轻量，不受 profile 列表长度影响。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "include_profiles": {
            "type": "boolean",
            "description": "是否返回每个分组里的 profile 列表"
          }
        }
      }
    },
    {
      "name": "folder_rename",
      "description": "重命名一个文件夹，ShardX 会同步重打所有成员的 folder 标签。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "folder": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "folder",
          "name"
        ]
      }
    },
    {
      "name": "folder_delete",
      "description": "删除文件夹。delete_profiles=true 连同环境一起删；false（默认）只把环境移出分组，不删环境。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "folder": {
            "type": "string"
          },
          "delete_profiles": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "folder"
        ]
      }
    },
    {
      "name": "profile_get",
      "description": "按 ID 读取一个指纹环境的完整配置。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "profile_id": {
            "type": "string"
          }
        },
        "required": [
          "profile_id"
        ]
      }
    },
    {
      "name": "profile_create",
      "description": "创建一个指纹环境：不传 fingerprint 时按 platform 自动生成；folder 直接归档到分组（不存在的分组会随创建出现）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "folder": {
            "type": "string"
          },
          "proxy": {
            "type": "string",
            "description": "代理字符串，例如 socks5://user:pass@host:port"
          },
          "proxy_id": {
            "type": "string",
            "description": "已存代理的 ID"
          },
          "platform": {
            "type": "string",
            "enum": [
              "Windows",
              "macOS",
              "Linux"
            ]
          },
          "color": {
            "type": "string",
            "description": "#rrggbb"
          },
          "extensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "扩展库 ID 列表"
          },
          "refresh_rate": {
            "type": "number",
            "description": "声称的屏幕刷新率 24-480"
          },
          "fingerprint": {
            "type": "object",
            "description": "完整指纹对象；省略则自动生成"
          }
        }
      }
    },
    {
      "name": "profile_edit",
      "description": "修改指纹环境：改名、备注、移动到分组（folder=\"\" 取消归档）、换代理、换颜色、扩展、指纹；只改传入的字段。",
