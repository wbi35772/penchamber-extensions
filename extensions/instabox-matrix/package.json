{
  "name": "openchamber-instabox-matrix",
  "version": "1.4.0",
  "private": true,
  "description": "Multi-account Instabox machine matrix for OpenChamber, with local service proxy and MCP agent tools.",
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.5.0"
    },
    "contributes": {
      "panel": {
        "id": "instabox-matrix",
        "name": "Instabox Matrix",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      },
      "tools": [
        {
          "match": "mcp.instabox-matrix.*",
          "name": "Instabox",
          "icon": "server",
          "title": "Instabox",
          "output": "markdown"
        }
      ]
    }
  }
}
